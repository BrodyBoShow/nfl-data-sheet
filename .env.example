# Copy to .env and fill in. Never commit .env (it's gitignored).
# In GitHub Actions, these are set as repository Secrets instead.

# Required from Phase 1 on. Supabase project settings -> Database -> Connection string
# (use the "URI" / session pooler connection string, not the pgbouncer transaction one,
# since db/migrate.py and pipeline/core/db.py run multi-statement DDL and transactions).
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Optional, not required until the web app (Phase 6) reads Supabase directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 6: the publishable key (sb_publishable_...) if the project has one, else the
# legacy anon key. Treat it as public. It can read only the `web` schema (migration 0026).
# Used by scripts/verify_anon_access.py and the web app, never by the pipeline.
SUPABASE_ANON_KEY=

# Optional, required starting Phase 4 (odds collector).
ODDS_API_KEY=

# Optional. If unset, the auditor prints alerts instead of posting to Discord.
DISCORD_WEBHOOK_URL=

# Optional, Phase 8 only (narrator / LLM news parsing).
ANTHROPIC_API_KEY=
